            </a>

          </div>

        </div>

      </article>



      <!-- PRODUCTO 2 -->

      <article class="product-card reveal">

        <div class="product-cover">

          <div class="ebook-placeholder">

            <small>BLER DIGITAL</small>

            <strong>
              SEGUNDO<br>
